---
import { SOCIAL_LINKS, CURRENTLY_USING } from '../consts';
import { revision } from '../lib/git';

const { rev, updated } = revision();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="sheet grid">
    <div class="col id">
      <p class="who">Wilson C.</p>
      <p class="line">Engineering notebook. Machines, software, teaching and essays, kept in Melbourne.</p>
    </div>

    <div class="col">
      <p class="meta meta--ink">Currently using</p>
      <ul role="list">
        {CURRENTLY_USING.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="col">
      <p class="meta meta--ink">Elsewhere</p>
      <ul role="list">
        <li><a class="link" href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a class="link" href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a class="link" href="/about#contact">Email</a></li>
        <li><a class="link" href="/rss.xml">RSS</a></li>
      </ul>
    </div>

    <div class="col">
      <p class="meta meta--ink">Colophon</p>
      <p class="small">Set in Schibsted Grotesk and IBM Plex Mono. Built with Astro.</p>
      <p class="meta">{rev} &nbsp;/&nbsp; {updated}</p>
    </div>
  </div>

  <div class="sheet base">
    <span class="meta">&copy; {year} Wilson C.</span>
    <a class="go" href="#main">Top <span class="arrow" aria-hidden="true">&#8593;</span></a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s9);
    border-top: var(--line);
    font-size: var(--fs-small);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 0.8fr 1fr;
    gap: var(--s6) var(--gap);
    padding-block: var(--s6) var(--s7);
  }

  .col p { margin: 0 0 var(--s3); }
  .who { color: var(--ink); font-weight: 600; font-size: 1rem; }
  .line { color: var(--muted); max-width: 26ch; }
  .small { color: var(--ink-2); max-width: 28ch; }

  ul { list-style: none; margin: 0; padding: 0; color: var(--ink-2); }
  li { padding-block: 0.12rem; }

  .base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: var(--s4);
    border-top: var(--hair);
  }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .id { grid-column: 1 / -1; }
  }
</style>
