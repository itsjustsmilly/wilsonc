---
import { NAV_ITEMS } from '../config/nav';
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="sheet bar">
    <a href="/" class="name" aria-label="Wilson C., home">
      Wilson C.<span class="meta name-tag">Notebook</span>
    </a>

    <nav aria-label="Main">
      <ul role="list">
        {NAV_ITEMS.map(({ label, href, external }) => (
          <li>
            <a
              href={href}
              class:list={['nav-link', { active: !external && isActive(href) }]}
              aria-current={!external && isActive(href) ? 'page' : undefined}
              {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {label}{external && <span class="ext" aria-hidden="true">&#8599;</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(6px);
    -webkit-backdrop-filter: saturate(1.2) blur(6px);
    border-bottom: var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--s5);
    height: 3.25rem;
  }

  .name {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    white-space: nowrap;
  }
  .name-tag { transition: color var(--t-fast) var(--ease); }
  .name:hover .name-tag { color: var(--accent); }

  nav { margin-left: auto; }
  ul {
    display: flex;
    gap: clamp(0.9rem, 2.4vw, 1.9rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The active/hover mark is a dimension line: a rule with end ticks. */
  .nav-link {
    position: relative;
    display: inline-block;
    padding-block: 0.4rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
    transition: color var(--t-fast) var(--ease);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.1rem;
    height: 5px;
    border-bottom: 1px solid var(--accent);
    border-left: 1px solid var(--accent);
    border-right: 1px solid var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t) var(--ease);
  }
  .nav-link:hover { color: var(--ink); }
  .nav-link:hover::after, .nav-link.active::after { transform: scaleX(1); }
  .nav-link.active { color: var(--accent); }
  .ext { font-size: 0.8em; margin-left: 0.15em; color: var(--muted); }

  @media (max-width: 560px) {
    .bar { gap: var(--s3); }
    .name-tag { display: none; }
    ul { gap: 0.85rem; }
    .nav-link { font-size: 0.875rem; }
  }
</style>
