---
// One item "on the bench": number and category in the margin, work in the body.
interface Props {
  n: number;
  title: string;
  category: string;
  summary: string;
  status: string;
  next?: string;
  href?: string;
}
const { n, title, category, summary, status, next, href } = Astro.props;
const Tag = href ? 'a' : 'div';

---

<Tag class="row row--tight bench" {...(href ? { href } : {})}>
  <div class="m">
    <span class="meta num">01.{n}</span>
    <span class="meta">{category}</span>
  </div>
  <div class="b">
    <div class="head">
      <h3>{title}</h3>
      <span class="meta status">{status}</span>
    </div>
    <p class="summary">{summary}</p>
    {next && (
      <p class="next">
        <span class="meta">Next</span>
        <span>{next}</span>
      </p>
    )}
  </div>
</Tag>

<style>
  .bench { color: inherit; }
  .bench + :global(.bench) > .b, .bench + :global(.bench) > .m { border-top: var(--hair); }

  .num { transition: color var(--t-fast) var(--ease); }
  a.bench:hover .num { color: var(--accent); }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s4);
    margin-bottom: var(--s2);
  }
  h3 {
    font-size: var(--fs-h3);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    transition: color var(--t-fast) var(--ease);
  }
  a.bench:hover h3 { color: var(--accent); }

  .summary { margin: 0 0 var(--s2); max-width: 56ch; }
  .next {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    margin: 0;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .bench + :global(.bench) > .m { border-top: var(--hair); }
    .bench + :global(.bench) > .b { border-top: 0; }
    .head { flex-direction: column; gap: 0.2rem; }
  }
</style>
