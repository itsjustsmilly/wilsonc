---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import { getProjects, variantFor } from '../lib/content';

const projects = await getProjects();
---

<BaseLayout
  title="Work"
  description="Machines, prototypes and software: build notes from robotics, mechanical design, 3D printing and education tools."
>
  <div class="sheet">
    <PageHead
      index="02"
      label="Work"
      title="Work"
      lead="Machines, prototypes and software. Each entry is a build log: the constraints, what I tried, what broke, and what changed because of it."
    >
      <span slot="margin" class="meta">{projects.length} entries</span>
    </PageHead>

    <!-- Register: a compact drawing-register style index -->
    <div class="row row--flush">
      <div class="m"></div>
      <div class="b">
        <table class="register">
          <thead>
            <tr class="meta">
              <th scope="col">No.</th>
              <th scope="col">Project</th>
              <th scope="col" class="hide-sm">Category</th>
              <th scope="col">Year</th>
              <th scope="col" class="hide-sm">Status</th>
            </tr>
          </thead>
          <tbody>
            {projects.map((p) => (
              <tr>
                <td class="meta">P.{String(p.data.number).padStart(2, '0')}</td>
                <td><a href={`/projects/${p.id}`}>{p.data.title}</a></td>
                <td class="meta hide-sm">{p.data.category}</td>
                <td class="meta">{p.data.year}</td>
                <td class="meta status hide-sm">{p.data.status}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <SectionHead index="02.1" label="Entries" />
    {projects.map((p, i) => (
      <ProjectEntry
        href={`/projects/${p.id}`}
        number={p.data.number}
        year={p.data.year}
        title={p.data.title}
        description={p.data.description}
        category={p.data.category}
        status={p.data.status}
        role={p.data.role}
        image={p.data.image}
        imageAlt={p.data.imageAlt}
        variant={variantFor(i)}
      />
    ))}
  </div>
</BaseLayout>

<style>
  .register {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--s7);
  }
  .register th, .register td {
    text-align: left;
    padding: 0.7rem 1rem 0.7rem 0;
    border-bottom: var(--hair);
    vertical-align: baseline;
  }
  .register thead th { font-weight: 400; border-bottom: var(--line); padding-top: 0; }
  .register td:first-child, .register th:first-child { width: 4.5rem; }
  .register a { color: var(--ink); font-weight: 500; transition: color var(--t-fast) var(--ease); }
  .register tr:hover a, .register tr:hover td:first-child { color: var(--accent); }

  @media (max-width: 640px) {
    .hide-sm { display: none; }
  }
</style>
