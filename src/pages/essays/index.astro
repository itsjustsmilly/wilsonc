---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import SectionHead from '../../components/SectionHead.astro';
import EssayEntry from '../../components/EssayEntry.astro';
import { getEssays } from '../../lib/content';

const essays = await getEssays();
---

<BaseLayout
  title="Writing"
  description="Essays on AI, education, engineering and university, from an engineering student who also teaches."
>
  <div class="sheet">
    <PageHead
      index="03"
      label="Writing"
      title="Writing"
      lead="Essays on AI, education, engineering and what it is like to study and teach at the same time."
    >
      <span slot="margin" class="meta">{essays.length} essays</span>
      <a slot="margin" class="go" href="/rss.xml">RSS <span class="arrow" aria-hidden="true">&#8594;</span></a>
    </PageHead>

    <SectionHead index="03.1" label="Newest first" />
    {essays.map(({ essay, n, minutes }) => (
      <EssayEntry
        href={`/essays/${essay.id}`}
        n={n}
        date={essay.data.date}
        title={essay.data.title}
        description={essay.data.description}
        tags={essay.data.tags}
        minutes={minutes}
      />
    ))}
  </div>
</BaseLayout>
