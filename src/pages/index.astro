---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import BenchEntry from '../components/BenchEntry.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import EssayEntry from '../components/EssayEntry.astro';
import { PROFILE } from '../consts';
import { getBench, getEssays, getProjects, variantFor } from '../lib/content';
import { revision } from '../lib/git';

const bench = await getBench();
const projects = await getProjects();
const essays = await getEssays();
const { rev, updated } = revision();
---

<BaseLayout>
  <div class="sheet">

    <!-- 00 / INDEX -->
    <section class="row intro" aria-labelledby="intro-title">
      <div class="m">
        <span class="meta meta--accent">00 / Index</span>
        <span class="meta">{rev}</span>
        <span class="meta">Upd. {updated}</span>
      </div>
      <div class="b">
        <svg class="datum" viewBox="0 0 15 15" aria-hidden="true">
          <circle cx="7.5" cy="7.5" r="4" fill="var(--bg)" stroke="currentColor" stroke-width="1" />
          <path d="M7.5 0v15M0 7.5h15" stroke="currentColor" stroke-width="1" />
        </svg>

        <p class="meta meta--ink kicker">Wilson C.</p>
        <h1 id="intro-title">Engineering student building machines, software and systems.</h1>

        <div class="intro-grid">
          <p class="bio">
            I study mechanical engineering and biomedical science at Monash. Most of my time goes into
            things I can test: a tracked farm rover, 3D-printed parts, and software for the VCE English
            students I tutor. This is where I keep the build notes, including the parts that failed,
            and the essays I write on AI, education and where engineering is heading.
          </p>

          <dl class="spec profile">
            {PROFILE.map(({ label, value }) => (
              <>
                <dt class="meta">{label}</dt>
                <dd>{value}</dd>
              </>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- 01 / ON THE BENCH -->
    <section aria-labelledby="bench">
      <SectionHead index="01" label="On the bench" id="bench" />
      {bench.map(({ data }, i) => (
        <BenchEntry n={i + 1} {...data} />
      ))}
    </section>

    <!-- 02 / SELECTED WORK -->
    <section aria-labelledby="work">
      <SectionHead index="02" label="Selected work" id="work" href="/projects" linkLabel="Project register" />
      {projects.map((p, i) => (
        <ProjectEntry
          href={`/projects/${p.id}`}
          number={p.data.number}
          year={p.data.year}
          title={p.data.title}
          description={p.data.description}
          category={p.data.category}
          status={p.data.status}
          role={p.data.role}
          image={p.data.image}
          imageAlt={p.data.imageAlt}
          variant={variantFor(i)}
        />
      ))}
    </section>

    <!-- 03 / WRITING -->
    <section aria-labelledby="writing">
      <SectionHead index="03" label="Writing" id="writing" href="/essays" linkLabel="All essays" />
      {essays.map(({ essay, n, minutes }) => (
        <EssayEntry
          href={`/essays/${essay.id}`}
          n={n}
          date={essay.data.date}
          title={essay.data.title}
          description={essay.data.description}
          tags={essay.data.tags}
          minutes={minutes}
        />
      ))}
    </section>

  </div>
</BaseLayout>

<style>
  .intro > .m, .intro > .b { padding-block: var(--s8) var(--s7); }
  .intro > .b { position: relative; }

  /* One datum mark, sitting on the margin line */
  .datum { left: -8px; top: calc(var(--s8) + 0.1rem); }

  .kicker { margin-bottom: var(--s4); }

  h1 {
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    letter-spacing: -0.035em;
    font-weight: 600;
    max-width: 17ch;
    text-wrap: balance;
    margin-bottom: var(--s6);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--gap);
    align-items: start;
  }
  .bio {
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--ink-2);
    margin: 0;
    max-width: 44ch;
  }

  @media (max-width: 900px) {
    .intro-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .intro > .m { padding-block: var(--s6) 0; }
    .intro > .b { padding-block: var(--s4) var(--s6); }
    .datum { display: none; }
  }
</style>
