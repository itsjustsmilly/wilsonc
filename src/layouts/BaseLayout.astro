---
// Wraps every page: <head>, header, slot, footer.
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
} = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <BaseHead title={title} description={description} image={image} />
    <!-- Light by default; a stored choice wins. Runs before paint to avoid a flash. -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip meta" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Figure hover detail: reveal the real pixel dimensions of each image.
      const label = (img: HTMLImageElement) => {
        const slot = img.closest('.fig, .media')?.querySelector('.fig-dims');
        if (slot && img.naturalWidth) slot.textContent = `${img.naturalWidth} × ${img.naturalHeight} px`;
      };
      document.querySelectorAll<HTMLImageElement>('.fig img, .media img').forEach((img) => {
        if (img.complete) label(img);
        else img.addEventListener('load', () => label(img), { once: true });
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--gutter);
    top: -3rem;
    z-index: 200;
    background: var(--ink);
    color: var(--bg);
    padding: 0.5rem 0.75rem;
  }
  .skip:focus { top: 0.5rem; }
  main { min-height: 60vh; }
</style>
